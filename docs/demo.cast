[1.0695, "o", "\r   \u001b[38;5;214m✿\u001b[0m \u001b[2m1996-10-22\u001b[0m  \u001b[38;5;230mWelcome to GeoCities Home Page\u001b[0m\u001b[0m\u001b[K\u001b[0m  \u001b[38;5;141mS1\u001b[0m\r\n\r   \u001b[38;5;214m✿\u001b[0m \u001b[2m1998-01-23\u001b[0m  \u001b[38;5;230mGeoCities - The Largest Community on the Web!\u001b[0m\u001b[0m\u001b[K\u001b[0m  \u001b[38;5;141mS2\u001b[0m\r\n\r   \u001b[38;5;214m✿\u001b[0m \u001b[2m1999-02-02\u001b[0m  \u001b[38;5;230mWelcome to GeoCities\u001b[0m\u001b[0m\u001b[K\u001b[0m  \u001b[38;5;141mS3\u001b[0m\r\n\r   \u001b[38;5;214m✿\u001b[0m \u001b[2m2004-05-07\u001b[0m  \u001b[38;5;230mYahoo! GeoCities - Your Home on the Web®\u001b[0m\u001b[0m\u001b[K\u001b[0m  \u001b[38;5;141mS4\u001b[0m\r\n\r   \u001b[38;5;214m✿\u001b[0m \u001b[2m2005-07-04\u001b[0m  \u001b[38;5;230mYahoo! GeoCities\u001b[0m\u001b[0m\u001b[K\u001b[0m  \u001b[38;5;141mS5\u001b[0m\r\n"]
